---
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Storm Island — A Reading Map</title>
    <meta
      name="description"
      content="An interactive 3D reading map of Storm Island, for book clubs reading These Summer Storms by Sarah MacLean."
    />
    <meta name="theme-color" content="#0b1716" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/fun/these-summer-storms/style.css" />
  </head>
  <body>
    <canvas id="world" aria-label="An interactive three-dimensional map of Storm Island"></canvas>
    <div class="vignette" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <div id="markers" aria-hidden="true"></div>

    <aside class="rail" id="rail">
      <header class="brand">
        <div class="brand-eyebrow">A reading map</div>
        <h1 class="brand-title">Storm <em>Island</em></h1>
        <p class="brand-sub">These Summer Storms<br /><span>Sarah MacLean</span></p>
      </header>

      <nav class="places" id="places" aria-label="Places on Storm Island"></nav>

      <div class="rail-foot">
        <div class="trail">
          <div class="trail-label"><span>The trail</span><span id="trailCount">0 / 9</span></div>
          <div class="trail-bar" id="trailBar" aria-hidden="true"></div>
          <button class="reset" id="resetTrail" type="button">Clear the trail</button>
        </div>

        <button class="weather" id="weather" type="button" aria-pressed="false">
          <span class="weather-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
              <path d="M7.5 17.5h9a3.5 3.5 0 0 0 .4-7 5 5 0 0 0-9.7-1.2A3.8 3.8 0 0 0 7.5 17.5Z" />
              <path class="bolt" d="m11.4 13.8-1.7 3h2.3l-1.5 3" />
            </svg>
          </span>
          <span class="weather-copy">
            <b id="weatherTitle">Calm evening</b>
            <small id="weatherSub">Summon the storm</small>
          </span>
          <span class="switch" aria-hidden="true"><i></i></span>
        </button>
      </div>
    </aside>

    <div class="hud">
      <div class="compass" aria-hidden="true">
        <svg viewBox="0 0 64 64">
          <circle cx="32" cy="32" r="22" fill="none" stroke="currentColor" stroke-opacity=".28" />
          <circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-opacity=".1" />
          <path d="M32 6v5M32 53v5M6 32h5M53 32h5" stroke="currentColor" stroke-opacity=".45" />
          <text x="32" y="13.5" text-anchor="middle" font-size="6.5" fill="currentColor" fill-opacity=".8" font-family="Inter, sans-serif" letter-spacing="1">N</text>
          <g id="needle">
            <path d="M32 20l3.4 12L32 30l-3.4 2Z" fill="currentColor" fill-opacity=".9" />
            <path d="M32 44l-3.4-12L32 34l3.4-2Z" fill="currentColor" fill-opacity=".3" />
          </g>
        </svg>
      </div>
      <div class="hints" id="hints">
        <span>Drag to orbit</span><i></i><span>Scroll to zoom</span><i></i><span>Select a place</span>
      </div>
    </div>

    <div class="coords" aria-hidden="true">41° 26′ N &nbsp;·&nbsp; 71° 20′ W &nbsp;·&nbsp; Narragansett Bay</div>

    <aside class="reader" id="reader" aria-hidden="true" aria-label="Reading panel">
      <button class="reader-close" id="closeReader" type="button" aria-label="Close the reading panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <div class="reader-scroll" id="readerScroll"></div>
    </aside>

    <div class="intro" id="intro">
      <div class="intro-inner">
        <div class="intro-eyebrow"><span></span>Narragansett Bay · 63 acres</div>
        <h2 class="intro-title">Storm <em>Island</em></h2>
        <p class="intro-line">A map of weather, money, and the people who inherit both.</p>
        <p class="intro-body">
          Nine places. Eighteen questions. One island with no road to it and no way to leave
          without someone noticing. Wander the grounds, open a place, and take the conversation
          back to your book club.
        </p>
        <button class="enter" id="enter" type="button">Step ashore <span aria-hidden="true">→</span></button>
        <p class="intro-note">Spoilers ahead · Fan-made, not affiliated with the author or publisher.</p>
      </div>
      <div class="intro-aside">The island was called <em>Auka</em> first —<br />an Algonquian word for tempest.</div>
    </div>

    <noscript>
      <div class="noscript">
        This map needs JavaScript. The nine places it follows are: the Dock, the Manor, the Study,
        the Boathouse, the Red Oak, the Fog Bell, the Thyme Field, the Secret Beach, and The Lizzie.
      </div>
    </noscript>

    <script is:inline type="module" src="/fun/these-summer-storms/island.js"></script>
  </body>
</html>
