---
export const prerender = false;

import MainLayout from "@/layouts/main.astro";
import LuckyDuckProposalContent from "@/components/LuckyDuckProposalContent.astro";
import {
  PROPOSAL_LUCKY_DUCK_USERNAME,
  PROPOSAL_LUCKY_DUCK_PASSWORD,
} from "astro:env/server";

/*
 * Credentials
 * ---------------------------------------------------------------
 * Secret server variables, read at runtime on Cloudflare. Set these in
 * Cloudflare → Settings → Environment variables (Production + Preview):
 *
 *   PROPOSAL_LUCKY_DUCK_USERNAME
 *   PROPOSAL_LUCKY_DUCK_PASSWORD
 *
 * For local development, put them in a gitignored `.env` file.
 * No working password is committed to source.
 */
const VALID_USERNAME = PROPOSAL_LUCKY_DUCK_USERNAME;
const VALID_PASSWORD = PROPOSAL_LUCKY_DUCK_PASSWORD;
const isConfigured = Boolean(VALID_USERNAME && VALID_PASSWORD);

const COOKIE_NAME = "proposal_lucky_duck_auth";
const COOKIE_PATH = "/private/proposals/lucky-duck-car-service";

async function sha256Hex(value: string) {
  const bytes = new TextEncoder().encode(value);
  const digest = await crypto.subtle.digest("SHA-256", bytes);
  return Array.from(new Uint8Array(digest))
    .map((byte) => byte.toString(16).padStart(2, "0"))
    .join("");
}

// The cookie stores a hash derived from the credentials, not a static string.
const sessionToken = isConfigured
  ? await sha256Hex(
      `${VALID_USERNAME}:${VALID_PASSWORD}:lucky-duck-car-service`,
    )
  : "";

Astro.response.headers.set("Cache-Control", "no-store, no-cache, must-revalidate");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

// Simple sign-out: /private/proposals/lucky-duck-car-service?logout=1
if (Astro.url.searchParams.has("logout")) {
  Astro.cookies.delete(COOKIE_NAME, { path: COOKIE_PATH });
  return Astro.redirect(Astro.url.pathname, 303);
}

let isAuthenticated =
  isConfigured && Astro.cookies.get(COOKIE_NAME)?.value === sessionToken;
let error = "";
let usernameValue = "";

if (Astro.request.method === "POST" && !isAuthenticated && isConfigured) {
  try {
    const formData = await Astro.request.formData();
    usernameValue = formData.get("username")?.toString() ?? "";
    const password = formData.get("password")?.toString() ?? "";

    const usernameMatches =
      usernameValue.trim().toLowerCase() === VALID_USERNAME?.toLowerCase();

    if (usernameMatches && password === VALID_PASSWORD) {
      Astro.cookies.set(COOKIE_NAME, sessionToken, {
        httpOnly: true,
        secure: import.meta.env.PROD,
        sameSite: "lax",
        maxAge: 60 * 60 * 24 * 7, // 7 days
        path: COOKIE_PATH,
      });
      return Astro.redirect(Astro.url.pathname, 303);
    }

    error = "That username or password doesn't match. Please try again.";
  } catch {
    error = "Something went wrong. Please try again.";
  }
}
---

<MainLayout
  title="Private Proposal - Lucky Duck Car Service"
  description="Private proposal document for Lucky Duck Car Service."
>
  <meta name="robots" content="noindex, nofollow, noarchive" slot="head" />
  {
    !isConfigured ? (
      <div class="min-h-[70vh] flex items-center justify-center px-4 py-16">
        <div class="w-full max-w-md bg-card rounded-2xl border border-border shadow-xl p-8 text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-amber-100 dark:bg-amber-950/40 mb-4">
            <svg
              class="w-7 h-7 text-amber-600 dark:text-amber-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
              ></path>
            </svg>
          </div>
          <h1 class="text-lg font-bold text-foreground">
            This proposal isn't configured yet
          </h1>
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
            Set <code class="text-xs bg-muted px-1 py-0.5 rounded"
              >PROPOSAL_LUCKY_DUCK_USERNAME</code
            >
            and <code class="text-xs bg-muted px-1 py-0.5 rounded"
              >PROPOSAL_LUCKY_DUCK_PASSWORD</code
            >
            in the environment, then rebuild.
          </p>
          <p class="mt-4 text-xs text-muted-foreground">
            Need help? Email
            <a href="mailto:info@smiling.dev" class="text-primary hover:underline"
              >info@smiling.dev</a
            >
          </p>
        </div>
      </div>
    ) : !isAuthenticated ? (
      <div class="min-h-[80vh] flex items-center justify-center px-4 py-16">
        <div class="w-full max-w-md">
          <div class="text-center mb-8">
            <a
              href="/"
              class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors"
            >
              <span class="font-semibold text-foreground">Smiling Dev</span>
            </a>
          </div>

          <div class="bg-card rounded-2xl border border-border shadow-xl p-8">
            <div class="mb-6 text-center">
              <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary/10 mb-4">
                <svg
                  class="w-7 h-7 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                  ></path>
                </svg>
              </div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary mb-2">
                Private client proposal
              </p>
              <h1 class="text-xl font-bold text-foreground">
                Lucky Duck Car Service
              </h1>
              <p class="text-sm text-muted-foreground mt-2">
                Enter your credentials to view the proposal.
              </p>
            </div>

            <form method="POST" class="space-y-4">
              <div>
                <label
                  for="username"
                  class="block text-sm font-medium text-foreground mb-1.5"
                >
                  Username
                </label>
                <input
                  id="username"
                  name="username"
                  type="text"
                  autocomplete="username"
                  value={usernameValue}
                  class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-sm"
                  required
                />
              </div>
              <div>
                <label
                  for="password"
                  class="block text-sm font-medium text-foreground mb-1.5"
                >
                  Password
                </label>
                <input
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-sm"
                  required
                />
              </div>

              {error && (
                <p class="text-sm text-red-600 dark:text-red-400" role="alert">
                  {error}
                </p>
              )}

              <button
                type="submit"
                class="w-full py-2.5 px-4 bg-primary text-primary-foreground rounded-lg font-medium text-sm hover:bg-primary/90 transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
              >
                View proposal
              </button>
            </form>

            <p class="mt-6 text-center text-xs text-muted-foreground">
              Don't have credentials? Email
              <a
                href="mailto:info@smiling.dev"
                class="text-primary hover:underline"
              >
                info@smiling.dev
              </a>
            </p>
          </div>

          <p class="mt-6 text-center text-xs text-muted-foreground">
            Confidential — prepared exclusively for Lucky Duck Car Service.
          </p>
        </div>
      </div>
    ) : (
      <LuckyDuckProposalContent />
    )
  }
</MainLayout>
