---
/*
 * Proposal content for Lucky Duck Car Service.
 * Rendered only after the password gate in the page route passes.
 */
import {
  ArrowRight,
  Baby,
  CalendarDays,
  Car,
  Check,
  ChevronRight,
  Clock,
  FileText,
  Globe,
  Hotel,
  Info,
  Luggage,
  Mail,
  MapPin,
  MessageSquare,
  Plane,
  Printer,
  Ship,
  ShieldCheck,
  Sparkles,
  Users,
  Wallet,
  Zap,
} from "@lucide/astro";

const proposalDate = "November 23, 2026";

const navItems = [
  { href: "#overview", label: "Executive summary", icon: "📋" },
  { href: "#today", label: "Where the day leaks", icon: "🌊" },
  { href: "#what-you-get", label: "What you're getting", icon: "🧩" },
  { href: "#walkthrough", label: "One booking, end to end", icon: "🦆" },
  { href: "#how-it-works", label: "How it works", icon: "⚙️" },
  { href: "#messages", label: "What customers see", icon: "💬" },
  { href: "#website", label: "The website", icon: "🌐" },
  { href: "#rollout", label: "Rollout plan", icon: "🗓️" },
  { href: "#investment", label: "Investment", icon: "💵" },
  { href: "#roles", label: "Who does what", icon: "🤝" },
  { href: "#assumptions", label: "Assumptions & questions", icon: "❓" },
  { href: "#next-steps", label: "Next steps", icon: "✅" },
];

const outcomes = [
  {
    stat: "Under 60 sec",
    label: "First reply to a new inquiry — day, night, or mid-sail.",
  },
  {
    stat: "3 automatic touches",
    label: "Every pickup: 24 hours, 3 hours, and 30 minutes out.",
  },
  {
    stat: "1 shared inbox",
    label: "Texts, email, Facebook messages, and website forms.",
  },
  {
    stat: "5–8 hours a week",
    label: "Estimated admin time returned to you. (We'll measure it.)",
  },
];

const painPoints = [
  {
    icon: "💬",
    title: "The group chat is the schedule",
    body: "Nine drivers, one thread, and whoever reads it last wins. Assignments and changes live in messages that scroll away — and in your head.",
  },
  {
    icon: "🔁",
    title: "Every customer is the same interview",
    body: "You ask the same dozen questions by text, then retype the answers into notes. The details are there, but never in the same place twice.",
  },
  {
    icon: "🧒",
    title: "Car seats are memory, not data",
    body: "A rear-facing seat for a one-year-old shouldn't be reconstructed from a text thread at 6 a.m. But today, that's the system.",
  },
  {
    icon: "💰",
    title: "Payment status is a feeling",
    body: "Zelle and Venmo work beautifully. But “did the Hendersons pay?” means scrolling, guessing, or texting them again.",
  },
  {
    icon: "📵",
    title: "Passengers disappear at sea",
    body: "You send instructions 24 hours out, and half your riders are on a ship with no signal. They get off — and need the details right now.",
  },
  {
    icon: "⭐",
    title: "Goodwill leaks after the ride",
    body: "Happy customers are your growth engine, but nobody has time to ask for the review, or to remember the family that sails every winter.",
  },
];

const pillars = [
  {
    icon: "🌐",
    title: "A website you're proud to send",
    body: "Routes, rough pricing, what to expect, and a request form. Built for the friend-of-a-friend who is about to Google you — and find nothing.",
  },
  {
    icon: "🗂️",
    title: "A CRM that remembers everything",
    body: "Every passenger, every trip, every car seat, every payment — in one record you can search in seconds instead of scrolling for minutes.",
  },
  {
    icon: "🤖",
    title: "An intake assistant that never sleeps",
    body: "Answers new texts, emails, and form submissions in seconds, asks the right questions, then hands you a complete summary.",
  },
  {
    icon: "🚐",
    title: "A dispatch view for nine drivers",
    body: "Separate calendars, clear assignments, and status updates — without group-chat archaeology. Everyone sees only what they need.",
  },
  {
    icon: "🔔",
    title: "Reminders that survive the ocean",
    body: "24 hours, 3 hours, and 30 minutes out — by email and text, with maps, driver details, and payment links. Sent and logged automatically.",
  },
  {
    icon: "💵",
    title: "Money tracked without spreadsheets",
    body: "Quote → invoice → payment pending → paid → completed, all visible at a glance. Keep Zelle and Venmo exactly as they are.",
  },
];

const journey = [
  {
    time: "Tuesday · 3:12 PM",
    tag: "customer",
    title: "A referral becomes a text",
    body: "Sarah Henderson saw your Facebook post and texts the business line: “Hi! Do you pick up at Port Canaveral? Family of 4, flying home Saturday.”",
  },
  {
    time: "Tuesday · 3:12 PM",
    tag: "auto",
    title: "The intake assistant answers in seconds",
    body: "It thanks her, confirms the route, and asks only what you actually need: sail date, ship, terminal, passengers, car seats, and luggage. No forms. No app to download.",
  },
  {
    time: "Tuesday · 3:18 PM",
    tag: "auto",
    title: "A complete record appears",
    body: "Sarah answers in five quick messages. Her contact and trip records are created, every field filled in, and the trip lands in your pipeline as “Info Collected.”",
  },
  {
    time: "Tuesday · 3:18 PM",
    tag: "you",
    title: "You get one clean summary",
    body: "Your phone buzzes once: “New trip — Henderson, 4 passengers, 1 booster, Port Canaveral T8 → MCO, Sat 9:30 AM, 4 bags.” No scrolling. No retyping.",
  },
  {
    time: "Tuesday · 3:40 PM",
    tag: "you",
    title: "You quote. It invoices.",
    body: "You reply with the price in the same thread. She says yes, you tap “Send invoice,” and she gets her trip summary with your Zelle and Venmo details — or a card link, if you add one later. Pipeline: Payment Pending.",
  },
  {
    time: "Wednesday · 10:02 AM",
    tag: "system",
    title: "Payment is recorded",
    body: "The $185 lands in Zelle. One tap marks it Paid (card payments mark themselves). The record now shows exactly what was paid, when, and how.",
  },
  {
    time: "Thursday",
    tag: "auto",
    title: "The right people get calendars",
    body: "You assign Carlos and the black Sienna. Two separate events go out: Sarah gets pickup time, terminal, and map; Carlos gets passengers, booster seat, luggage count, and terminal notes.",
  },
  {
    time: "Friday · 9:30 AM",
    tag: "auto",
    title: "24-hour email + text",
    body: "Sarah receives the detailed email and a short text: pickup window, Terminal 8 Zone B, a map pin, ship-delay instructions, and her balance. Both are logged to her record and visible in your shared inboxes. About half of cruise passengers are offline here — so we send it again later.",
  },
  {
    time: "Saturday · 6:30 AM",
    tag: "auto",
    title: "The 3-hour reminder lands on reconnect",
    body: "She's just off the ship and her phone comes back to life. The same details arrive again — right when she can actually read them.",
  },
  {
    time: "Saturday · 9:00 AM",
    tag: "auto",
    title: "30-minute “your driver is here”",
    body: "Final text: Carlos, black Toyota Sienna, plate LUCKY1, at Zone B by the blue canopy. Payment link included if a balance remains.",
  },
  {
    time: "Saturday · 10:15 AM",
    tag: "auto",
    title: "Ride complete — and the loop closes",
    body: "The trip moves to Completed. The next morning, a friendly review request goes out. That's the referral engine that already grows your business, on autopilot.",
  },
  {
    time: "Next booking",
    tag: "system",
    title: "She's already a known customer",
    body: "Next time Sarah texts, you already know her kids' ages, her booster seat, her preferred pickup, and her payment history. She feels remembered. You didn't do anything.",
  },
];

const tagStyles: Record<string, string> = {
  auto: "bg-primary/10 text-primary border-primary/20",
  you: "bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800/60",
  system:
    "bg-emerald-50 text-emerald-800 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60",
  customer:
    "bg-muted text-muted-foreground border-border",
};

const tagLabels: Record<string, string> = {
  auto: "Automatic",
  you: "You decide",
  system: "System",
  customer: "Customer",
};
---

<div class="min-h-screen bg-background">
  <!-- Reading progress -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 z-[60] h-[3px] w-0 bg-gradient-to-r from-primary to-accent no-print"
    aria-hidden="true"
  >
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <div class="lg:grid lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-10 xl:gap-14">
      <!-- Sidebar -->
      <aside class="hidden lg:block no-print">
        <div class="lg:sticky lg:top-24">
          <div class="mb-6">
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary mb-2">
              Private proposal
            </p>
            <p class="text-lg font-bold text-foreground leading-tight">
              Lucky Duck<br />Car Service
            </p>
            <p class="text-xs text-muted-foreground mt-2">
              Website, CRM &amp; automated dispatch
            </p>
          </div>

          <nav class="space-y-1" aria-label="Proposal sections">
            {navItems.map((item) => (
              <a
                href={item.href}
                class="nav-link flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-primary/5 hover:text-foreground transition-colors"
              >
                <span class="w-5 text-center text-[13px]" aria-hidden="true">
                  {item.icon}
                </span>
                <span>{item.label}</span>
              </a>
            ))}
          </nav>

          <div class="mt-6 rounded-xl border border-border bg-card p-4">
            <p class="text-xs text-muted-foreground leading-relaxed">
              Questions while you read? Email
              <a
                href="mailto:info@smiling.dev?subject=Lucky%20Duck%20proposal"
                class="text-primary hover:underline font-medium"
              >
                info@smiling.dev
              </a>
            </p>
            <a
              href="?logout=1"
              class="mt-3 inline-block text-xs text-muted-foreground hover:text-foreground transition-colors"
            >
              Sign out
            </a>
          </div>
        </div>
      </aside>

      <!-- Content column -->
      <div class="min-w-0 max-w-4xl">
        <!-- Mobile contents -->
        <details
          class="lg:hidden mb-6 rounded-xl border border-border bg-card no-print group"
        >
          <summary
            class="cursor-pointer list-none px-4 py-3 flex items-center justify-between text-sm font-semibold text-foreground"
          >
            <span class="flex items-center gap-2">
              <FileText size={16} class="text-primary" />
              Jump to a section
            </span>
            <ChevronRight
              size={16}
              class="text-muted-foreground transition-transform group-open:rotate-90"
            />
          </summary>
          <div class="grid grid-cols-2 gap-1 px-3 pb-3">
            {navItems.map((item) => (
              <a
                href={item.href}
                class="rounded-lg px-2.5 py-2 text-xs text-muted-foreground hover:bg-primary/5 hover:text-foreground"
              >
                {item.icon} {item.label}
              </a>
            ))}
          </div>
        </details>

        <!-- ============================= HERO ============================= -->
        <header
          class="relative overflow-hidden rounded-2xl border border-border bg-card shadow-sm p-6 sm:p-10 mb-6"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-primary/10 via-accent/10 to-transparent pointer-events-none"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <div class="flex flex-wrap items-center gap-3 mb-5">
              <span
                class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-primary"
              >
                <span aria-hidden="true">🦆</span> Private client proposal
              </span>
              <span
                class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background/70 px-3 py-1 text-[11px] font-medium text-muted-foreground"
              >
                <ShieldCheck size={12} /> Confidential
              </span>
            </div>

            <p class="text-sm font-medium text-muted-foreground mb-2">
              Prepared for Lucky Duck Car Service
            </p>
            <h1
              class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground leading-[1.08] tracking-tight"
            >
              Your business, running from one calm command center.
            </h1>
            <p
              class="mt-5 text-base sm:text-lg text-foreground/85 leading-relaxed max-w-2xl"
            >
              A branded website, a CRM that remembers every passenger detail,
              separate calendars for you and your drivers, and pickup reminders
              that still reach travelers after a week offline at sea.
            </p>
            <p class="mt-3 text-sm text-muted-foreground">
              You keep the relationships. I'll build and run the machine behind
              them.
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-3 no-print">
              <a
                href="#investment"
                class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors"
              >
                Jump to investment
                <ArrowRight size={16} />
              </a>
              <a
                href="#walkthrough"
                class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2.5 text-sm font-semibold text-foreground hover:bg-muted/60 transition-colors"
              >
                See it in action
              </a>
              <button
                type="button"
                id="print-proposal"
                class="inline-flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
              >
                <Printer size={15} />
                Print / save PDF
              </button>
            </div>

            <div
              class="mt-9 grid grid-cols-2 lg:grid-cols-4 gap-4 border-t border-border pt-6"
            >
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                  Prepared by
                </p>
                <p class="mt-1 text-sm font-semibold text-foreground">
                  Bryson<br class="hidden sm:block" /> Smiling Dev Consulting
                </p>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                  Date
                </p>
                <p class="mt-1 text-sm font-semibold text-foreground">
                  {proposalDate}
                </p>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                  Valid through
                </p>
                <p class="mt-1 text-sm font-semibold text-foreground">
                  30 days
                </p>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                  Engagement
                </p>
                <p class="mt-1 text-sm font-semibold text-foreground">
                  Build + monthly
                </p>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
              <span
                class="rounded-full bg-background/80 border border-border px-3 py-1.5 text-xs font-semibold text-foreground"
                >Website · $1,500</span
              >
              <span
                class="rounded-full bg-background/80 border border-border px-3 py-1.5 text-xs font-semibold text-foreground"
                >CRM &amp; automation · $4,500</span
              >
              <span
                class="rounded-full bg-background/80 border border-border px-3 py-1.5 text-xs font-semibold text-foreground"
                >Ongoing · $500/mo</span
              >
            </div>
          </div>
        </header>

        <!-- ============================= OVERVIEW ============================= -->
        <section
          id="overview"
          class="scroll-mt-28 bg-card rounded-2xl border border-border shadow-sm p-6 sm:p-8 mb-6"
        >
          <div class="flex items-start gap-4 mb-6">
            <div
              class="shrink-0 w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center"
            >
              <FileText size={22} />
            </div>
            <div>
              <p
                class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary mb-1"
              >
                The short version
              </p>
              <h2 class="text-2xl sm:text-3xl font-bold text-foreground leading-tight">
                The business already works. This makes it easier to run.
              </h2>
            </div>
          </div>

          <div class="space-y-4 text-foreground/85 leading-relaxed">
            <p>
              Your growth is coming from trust: Facebook posts, referrals, and
              people telling their friends “use Lucky Duck — they were waiting
              when we got off the ship.” That's the best kind of growth there
              is. It's also the kind that breaks a manual system.
            </p>
            <p>
              At nine drivers, you are the dispatch desk, the CRM, the reminder
              service, the billing department, and the customer service line.
              Most of that lives in your head, a group chat, and a text thread.
              Every new booking adds one more thing to remember — and the cost
              of forgetting is high: a family standing at the wrong curb with
              luggage and a ship to catch.
            </p>
            <p>
              This is not a rebuild. The business already works. This is taking
              the parts that live in your head and your messages and putting
              them into a system that does the repetitive work for you, while
              you stay in charge of pricing, drivers, and the relationships.
            </p>
            <p class="font-medium text-foreground">
              The goal is simple: you open one screen in the morning and know
              exactly what's happening today, what's been paid, who's driving,
              and who's been taken care of. No scrolling required.
            </p>
          </div>

          <div class="mt-7 grid sm:grid-cols-2 gap-4">
            {outcomes.map((item) => (
              <div class="rounded-xl border border-border bg-background/60 p-4">
                <p class="text-lg font-bold text-primary leading-tight">
                  {item.stat}
                </p>
                <p class="mt-1 text-sm text-muted-foreground leading-snug">
                  {item.label}
                </p>
              </div>
            ))}
          </div>

          <div
            class="mt-6 rounded-xl border border-primary/20 bg-primary/5 p-5"
          >
            <p class="text-sm text-foreground leading-relaxed">
              <strong class="font-semibold">In one sentence:</strong> every
              inquiry gets answered, every detail gets recorded, every pickup
              gets three reminders, every driver gets their own calendar, and
              every dollar gets tracked — without you holding it all in your
              head.
            </p>
          </div>
        </section>

        <!-- ============================= TODAY ============================= -->
        <section
          id="today"
          class="scroll-mt-28 bg-card rounded-2xl border border-border shadow-sm p-6 sm:p-8 mb-6"
        >
          <div class="flex items-start gap-4 mb-6">
            <div
              class="shrink-0 w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center"
            >
              <Clock size={22} />
            </div>
            <div>
              <p
                class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary mb-1"
              >
                Why this matters now
              </p>
              <h2 class="text-2xl sm:text-3xl font-bold text-foreground leading-tight">
                Where the day leaks
              </h2>
            </div>
          </div>

          <p class="text-foreground/85 leading-relaxed mb-6">
            None of this is a discipline problem. It's a systems problem. The
            work is real, the details are critical, and the tools (texts, group
            chats, memory) were never built to hold a business this size.
          </p>

          <div class="grid sm:grid-cols-2 gap-4">
            {painPoints.map((item) => (
              <div class="rounded-xl border border-border bg-background/50 p-5">
                <div class="flex items-start gap-3">
                  <span
                    class="text-xl leading-none mt-0.5"
                    aria-hidden="true">{item.icon}</span
                  >
                  <div>
                    <h3 class="font-semibold text-foreground mb-1.5">
                      {item.title}
                    </h3>
                    <p class="text-sm text-muted-foreground leading-relaxed">
                      {item.body}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <h3 class="mt-8 mb-3 font-semibold text-foreground">
            The same week, with a system
          </h3>
          <div class="overflow-x-auto rounded-xl border border-border">
            <table class="w-full text-sm min-w-[640px]">
              <thead class="bg-muted/70">
                <tr>
                  <th class="text-left px-4 py-3 font-semibold text-foreground w-1/2">
                    Today
                  </th>
                  <th class="text-left px-4 py-3 font-semibold text-foreground w-1/2">
                    With the system
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    New text → see it later → ask questions over 40 minutes
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Instant reply → details collected in about a minute → you get
                    a summary
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    Trip details spread across three threads and your memory
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    One record with every detail, searchable in seconds
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    Driver assignments in a group chat
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Separate calendar events, one per driver and rider
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    “Did they pay?” means manual checking
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Pipeline shows Pending, Paid, and Completed at a glance
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    Reminder texts typed by hand, when you remember
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Automatic at 24h, 3h, and 30m — with map, driver, and payment
                    link
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    Referrals go to Facebook Messenger and wait
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Referrals land on a website that answers questions and
                    captures the trip
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ============================= WHAT YOU GET ============================= -->
        <section
          id="what-you-get"
          class="scroll-mt-28 bg-card rounded-2xl border border-border shadow-sm p-6 sm:p-8 mb-6"
        >
          <div class="flex items-start gap-4 mb-6">
            <div
              class="shrink-0 w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center"
            >
              <Sparkles size={22} />
            </div>
            <div>
              <p
                class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary mb-1"
              >
                The six pieces
              </p>
              <h2 class="text-2xl sm:text-3xl font-bold text-foreground leading-tight">
                What you're getting
              </h2>
            </div>
          </div>

          <p class="text-foreground/85 leading-relaxed mb-6">
            Six connected pieces, built on one platform, branded as Lucky Duck.
            Each one solves a specific problem on its own — together they stop
            the daily scramble.
          </p>

          <div class="grid sm:grid-cols-2 gap-4">
            {pillars.map((item) => (
              <div
                class="rounded-xl border border-border bg-background/50 p-5 hover:border-primary/30 transition-colors"
              >
                <div class="flex items-start gap-3">
                  <span
                    class="shrink-0 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-xl"
                    aria-hidden="true">{item.icon}</span
                  >
                  <div>
                    <h3 class="font-semibold text-foreground mb-1.5">
                      {item.title}
                    </h3>
