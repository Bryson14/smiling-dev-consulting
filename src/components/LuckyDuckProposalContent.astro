---
/*
 * Proposal content for Lucky Duck Car Service.
 * Rendered only after the password gate in the page route passes.
 */
import {
  ArrowRight,
  Baby,
  Bell,
  Bird,
  Bot,
  CalendarDays,
  Car,
  Check,
  ChevronRight,
  CircleCheck,
  CircleQuestionMark,
  Clock,
  Database,
  Droplets,
  FileText,
  Globe,
  Handshake,
  Hotel,
  Info,
  Luggage,
  Mail,
  MapPin,
  MessageCircle,
  MessageSquare,
  Phone,
  PhoneOff,
  Plane,
  Printer,
  Puzzle,
  Repeat,
  Settings,
  Ship,
  ShieldCheck,
  Sparkles,
  Star,
  User,
  Users,
  Wallet,
  Zap,
} from "@lucide/astro";
import { Image } from "astro:assets";
import logo from "@/content/images/lucky-duck-car-service-logo.jpeg";

const proposalDate = "November 23, 2026";

const navItems = [
  { href: "#overview", label: "Executive summary", icon: FileText },
  { href: "#today", label: "Where time is lost", icon: Droplets },
  { href: "#what-you-get", label: "What you're getting", icon: Puzzle },
  { href: "#walkthrough", label: "One booking, end to end", icon: Bird },
  { href: "#how-it-works", label: "How it works", icon: Settings },
  { href: "#messages", label: "What customers see", icon: MessageSquare },
  { href: "#website", label: "The website", icon: Globe },
  { href: "#rollout", label: "Rollout plan", icon: CalendarDays },
  { href: "#investment", label: "Investment", icon: Wallet },
  { href: "#roles", label: "Who does what", icon: Handshake },
  {
    href: "#assumptions",
    label: "Assumptions & questions",
    icon: CircleQuestionMark,
  },
  { href: "#next-steps", label: "Next steps", icon: CircleCheck },
];

const outcomes = [
  {
    stat: "Under 60 sec",
    label: "First reply to a new inquiry, including outside business hours.",
  },
  {
    stat: "3 automatic messages",
    label: "Every pickup: 24 hours, 3 hours, and 30 minutes before.",
  },
  {
    stat: "1 shared inbox",
    label: "Texts, email, Facebook messages, and website forms.",
  },
  {
    stat: "5–8 hours a week",
    label:
      "Estimated administrative time saved. This will be measured after launch.",
  },
];

const painPoints = [
  {
    icon: MessageSquare,
    title: "The schedule lives in a group chat",
    body: "Nine drivers share one thread. Assignments and changes are in messages that scroll away, and the current schedule is also kept in your head.",
  },
  {
    icon: Repeat,
    title: "Each inquiry requires the same questions",
    body: "You ask the same questions by text, then retype the answers into notes. The information is available, but it is not stored in one place.",
  },
  {
    icon: Baby,
    title: "Car seat details are kept in messages",
    body: "A rear-facing seat for a one-year-old is recorded in a text thread, if at all. It has to be found again before the pickup.",
  },
  {
    icon: Wallet,
    title: "Payment status requires manual checks",
    body: "Zelle and Venmo work, but confirming whether a customer has paid means checking apps or texting them again.",
  },
  {
    icon: PhoneOff,
    title: "Passengers are often offline at sea",
    body: "Instructions sent 24 hours before a port pickup may not be seen until the ship returns to cellular service. The information is needed as soon as passengers disembark.",
  },
  {
    icon: Star,
    title: "Review requests are inconsistent",
    body: "Satisfied customers are the main source of new business, but there is no consistent process for asking for reviews or recording repeat customers.",
  },
];

const pillars = [
  {
    icon: Globe,
    title: "A public website",
    body: "Routes, rough pricing, what to expect, and a request form. It gives referred customers a place to check details before contacting you.",
  },
  {
    icon: Database,
    title: "A CRM with complete trip records",
    body: "Customer and trip details, including car seats and payments, are stored in one searchable record.",
  },
  {
    icon: Bot,
    title: "Automated intake",
    body: "New texts, emails, and form submissions receive an immediate reply. The assistant collects the required details and sends you a summary.",
  },
  {
    icon: Car,
    title: "Driver scheduling",
    body: "Separate calendars and clear assignments. Drivers see the trips assigned to them; you see the full schedule.",
  },
  {
    icon: Bell,
    title: "Automated pickup reminders",
    body: "Emails and texts at 24 hours, 3 hours, and 30 minutes before pickup, with maps, driver details, and payment information. Each send is logged.",
  },
  {
    icon: Wallet,
    title: "Payment tracking",
    body: "Quote, confirmation, completion, payment due, and paid stages are visible in one pipeline. Zelle and Venmo remain available.",
  },
];

const journey = [
  {
    time: "Tuesday · 3:12 PM",
    tag: "customer",
    title: "A referral arrives as a text",
    body: "Sarah Henderson sees a Facebook post and texts the business line: “Hi! Do you pick up at the Port of Galveston? Family of 4, flying home Saturday.”",
  },
  {
    time: "Tuesday · 3:12 PM",
    tag: "auto",
    title: "The intake assistant replies",
    body: "It confirms the route and asks for the sail date, ship, terminal, passenger count, car seats, and luggage. No form or app is required.",
  },
  {
    time: "Tuesday · 3:18 PM",
    tag: "auto",
    title: "A trip record is created",
    body: "Sarah answers in five messages. The contact and trip records are created with the fields filled in. The trip appears in the pipeline as “Info Collected.”",
  },
  {
    time: "Tuesday · 3:18 PM",
    tag: "you",
    title: "You receive an intake summary",
    body: "You get one notification with the trip details: “New trip: Henderson, 4 passengers, 1 booster, Port of Galveston T1 → IAH, Sat 9:30 AM, 4 bags.” This replaces manual entry and searching through the thread.",
  },
  {
    time: "Tuesday · 3:40 PM",
    tag: "you",
    title: "You confirm the price and send the trip confirmation",
    body: "You reply with the price in the same thread. After she confirms, you send a trip confirmation with the pickup details and total. It states that payment is due at drop-off, by Zelle or Venmo. The pipeline moves to Confirmed.",
  },
  {
    time: "Thursday",
    tag: "auto",
    title: "Driver assigned and calendars created",
    body: "You assign Carlos and the black Sienna. Sarah receives a rider event with the pickup time, terminal, and map. Carlos receives a separate event with passenger, car seat, luggage, and terminal details.",
  },
  {
    time: "Friday · 9:30 AM",
    tag: "auto",
    title: "24-hour email and text",
    body: "Sarah receives a detailed email and a short text with the pickup window, Terminal 1 pickup area, a map pin, ship-delay instructions, and a note that payment is collected at drop-off. Both messages are logged to the record and appear in the shared inboxes. Because about half of cruise passengers are offline at this point, the details are sent again later.",
  },
  {
    time: "Saturday · 6:30 AM",
    tag: "auto",
    title: "3-hour reminder",
    body: "She has just left the ship and her phone has service again. The same details are sent a second time.",
  },
  {
    time: "Saturday · 9:00 AM",
    tag: "auto",
    title: "30-minute reminder",
    body: "The final text includes the driver, vehicle, plate, pickup zone, and the amount due. Payment is collected at drop-off.",
  },
  {
    time: "Saturday · 10:15 AM",
    tag: "you",
    title: "Ride complete and payment collected",
    body: "The ride ends at IAH. Carlos collects the $185 by Zelle in the car, or you send a payment link afterward. You or the driver mark it Paid; the record shows the amount, time, and method.",
  },
  {
    time: "Sunday morning",
    tag: "auto",
    title: "Receipt and review request",
    body: "A receipt and review request are sent the next morning. The review link opens the Facebook review form directly.",
  },
  {
    time: "Next booking",
    tag: "system",
    title: "The customer record is reusable",
    body: "The next time Sarah books, her children's ages, car seat requirement, preferred pickup, and payment history are already in the record.",
  },
];

const tagStyles: Record<string, string> = {
  auto: "bg-primary/10 text-primary border-primary/20",
  you: "bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800/60",
  system:
    "bg-emerald-50 text-emerald-800 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60",
  customer:
    "bg-muted text-muted-foreground border-border",
};

const tagLabels: Record<string, string> = {
  auto: "Automatic",
  you: "You decide",
  system: "System",
  customer: "Customer",
};
---

<div class="min-h-screen bg-background">
  <!-- Reading progress -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 z-[60] h-[3px] w-0 bg-gradient-to-r from-primary to-accent no-print"
    aria-hidden="true"
  >
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <div class="lg:grid lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-10 xl:gap-14">
      <!-- Sidebar -->
      <aside class="hidden lg:block no-print">
        <div class="lg:sticky lg:top-24">
          <div class="mb-6">
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary mb-2">
              Private proposal
            </p>
            <p class="text-lg font-bold text-foreground leading-tight">
              Lucky Duck<br />Car Service
            </p>
            <p class="text-xs text-muted-foreground mt-2">
              Website, CRM &amp; automated dispatch
            </p>
          </div>

          <nav class="space-y-1" aria-label="Proposal sections">
            {navItems.map((item) => {
              const Icon = item.icon;
              return (
                <a
                  href={item.href}
                  class="nav-link flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-primary/5 hover:text-foreground transition-colors"
                >
                  <span
                    class="flex w-5 shrink-0 justify-center"
                    aria-hidden="true"
                  >
                    <Icon size={15} />
                  </span>
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>

          <div class="mt-6 rounded-xl border border-border bg-card p-4">
            <p class="text-xs text-muted-foreground leading-relaxed">
              Questions while you read? Email
              <a
                href="mailto:bryson@smiling.dev?subject=Lucky%20Duck%20proposal"
                class="text-primary hover:underline font-medium"
              >
                bryson@smiling.dev
              </a>
            </p>
            <a
              href="?logout=1"
              class="mt-3 inline-block text-xs text-muted-foreground hover:text-foreground transition-colors"
            >
              Sign out
            </a>
          </div>
        </div>
      </aside>

      <!-- Content column -->
      <div class="min-w-0 max-w-4xl">
        <!-- Mobile contents -->
        <details
          class="lg:hidden mb-6 rounded-xl border border-border bg-card no-print group"
        >
          <summary
            class="cursor-pointer list-none px-4 py-3 flex items-center justify-between text-sm font-semibold text-foreground"
          >
            <span class="flex items-center gap-2">
              <FileText size={16} class="text-primary" />
              Jump to a section
            </span>
            <ChevronRight
              size={16}
              class="text-muted-foreground transition-transform group-open:rotate-90"
            />
          </summary>
          <div class="grid grid-cols-2 gap-1 px-3 pb-3">
            {navItems.map((item) => {
              const Icon = item.icon;
              return (
                <a
                  href={item.href}
                  class="flex items-center gap-1.5 rounded-lg px-2.5 py-2 text-xs text-muted-foreground hover:bg-primary/5 hover:text-foreground"
                >
                  <Icon size={12} class="shrink-0 text-primary" />
                  <span>{item.label}</span>
                </a>
              );
            })}
          </div>
        </details>

        <!-- ============================= HERO ============================= -->
        <header
          class="relative overflow-hidden rounded-2xl border border-border bg-card shadow-sm p-6 sm:p-10 mb-6"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-primary/10 via-accent/10 to-transparent pointer-events-none"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
              <div class="flex items-center gap-3">
                <Image
                  src={logo}
                  alt="Lucky Duck Car Service logo"
                  width={192}
                  height={192}
                  class="h-20 w-20 sm:h-24 sm:w-24 rounded-2xl bg-white object-contain shadow-sm ring-1 ring-border"
                />
                <div>
                  <p
                    class="text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-foreground"
                  >
                    Prepared for
                  </p>
                  <p class="text-lg font-semibold text-foreground">
                    Lucky Duck Car Service
                  </p>
                  <p class="text-xs text-muted-foreground">
                    Galveston cruise port and IAH transfers
                  </p>
                </div>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <span
                  class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-primary"
                >
                  <span aria-hidden="true" class="inline-flex"
                    ><Bird size={13} /></span
                  >
                  Private client proposal
                </span>
                <span
                  class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background/70 px-3 py-1 text-[11px] font-medium text-muted-foreground"
                >
                  <ShieldCheck size={12} /> Confidential
                </span>
              </div>
            </div>

            <h1
              class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground leading-[1.08] tracking-tight"
            >
              A website, CRM, and automated dispatch system.
            </h1>
            <p
              class="mt-5 text-base sm:text-lg text-foreground/85 leading-relaxed max-w-2xl"
            >
              The system includes a branded website, a CRM for customer and
              trip details, separate rider and driver calendars, and automated
              pickup reminders sent by email and text.
            </p>
            <p class="mt-3 text-sm text-muted-foreground">
              I will build and maintain the system. You retain control of
              pricing, driver assignments, and customer relationships.
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-3 no-print">
              <a
                href="#investment"
                class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors"
              >
                View pricing
                <ArrowRight size={16} />
              </a>
              <a
                href="#walkthrough"
                class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2.5 text-sm font-semibold text-foreground hover:bg-muted/60 transition-colors"
              >
                View example booking
              </a>
              <button
                type="button"
                id="print-proposal"
                class="inline-flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
              >
                <Printer size={15} />
                Print / save PDF
              </button>
            </div>

            <div
              class="mt-9 grid grid-cols-2 lg:grid-cols-4 gap-4 border-t border-border pt-6"
            >
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                  Prepared by
                </p>
                <p class="mt-1 text-sm font-semibold text-foreground">
                  Bryson<br class="hidden sm:block" /> Smiling Dev Consulting
                </p>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                  Date
                </p>
                <p class="mt-1 text-sm font-semibold text-foreground">
                  {proposalDate}
                </p>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                  Valid through
                </p>
                <p class="mt-1 text-sm font-semibold text-foreground">
                  30 days
                </p>
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-muted-foreground">
                  Engagement
                </p>
                <p class="mt-1 text-sm font-semibold text-foreground">
                  Build + monthly
                </p>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
              <span
                class="rounded-full bg-background/80 border border-border px-3 py-1.5 text-xs font-semibold text-foreground"
                >Website · $1,500</span
              >
              <span
                class="rounded-full bg-background/80 border border-border px-3 py-1.5 text-xs font-semibold text-foreground"
                >CRM &amp; automation · $4,500</span
              >
              <span
                class="rounded-full bg-background/80 border border-border px-3 py-1.5 text-xs font-semibold text-foreground"
                >Ongoing · $500/mo</span
              >
            </div>
          </div>
        </header>

        <!-- ============================= OVERVIEW ============================= -->
        <section
          id="overview"
          class="scroll-mt-28 bg-card rounded-2xl border border-border shadow-sm p-6 sm:p-8 mb-6"
        >
          <div class="flex items-start gap-4 mb-6">
            <div
              class="shrink-0 w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center"
            >
              <FileText size={22} />
            </div>
            <div>
              <p
                class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary mb-1"
              >
                Summary
              </p>
              <h2 class="text-2xl sm:text-3xl font-bold text-foreground leading-tight">
                The business has outgrown its current tools.
              </h2>
            </div>
          </div>

          <div class="space-y-4 text-foreground/85 leading-relaxed">
            <p>
              Most inquiries come from Facebook and referrals. That has been
              enough to grow the business, but the current process (phone calls,
              texts, a group chat, and memory) does not scale with it. Most
              transfers are between IAH and the Port of Galveston, with some
              hotel transfers and side trips.
            </p>
            <p>
              With about nine drivers, dispatch, customer records, reminders,
              billing, and customer service all run through you. Most of that
              information is kept in your head, a group chat, and text threads.
              Each new booking adds more detail to track, and a missed detail
              can leave a family waiting at the wrong pickup zone.
            </p>
            <p>
              This proposal does not replace the business. It moves the
              repetitive parts (intake, reminders, records, and payment
              tracking) into one system, while you keep control of pricing,
              driver assignments, and customer relationships.
            </p>
            <p class="font-medium text-foreground">
              The intended result is one screen that shows the day's trips,
              payment status, driver assignments, and completed rides without
              searching through messages.
            </p>
          </div>

          <div class="mt-7 grid sm:grid-cols-2 gap-4">
            {outcomes.map((item) => (
              <div class="rounded-xl border border-border bg-background/60 p-4">
                <p class="text-lg font-bold text-primary leading-tight">
                  {item.stat}
                </p>
                <p class="mt-1 text-sm text-muted-foreground leading-snug">
                  {item.label}
                </p>
              </div>
            ))}
          </div>

          <div
            class="mt-6 rounded-xl border border-primary/20 bg-primary/5 p-5"
          >
            <p class="text-sm text-foreground leading-relaxed">
              <strong class="font-semibold">Summary:</strong> every inquiry is
              answered, every detail is recorded, every pickup has three
              reminders, every driver has a separate calendar, and every payment
              is tracked in one place.
            </p>
          </div>
        </section>

        <!-- ============================= TODAY ============================= -->
        <section
          id="today"
          class="scroll-mt-28 bg-card rounded-2xl border border-border shadow-sm p-6 sm:p-8 mb-6"
        >
          <div class="flex items-start gap-4 mb-6">
            <div
              class="shrink-0 w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center"
            >
              <Clock size={22} />
            </div>
            <div>
              <p
                class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary mb-1"
              >
                Current state
              </p>
              <h2 class="text-2xl sm:text-3xl font-bold text-foreground leading-tight">
                Where time is lost
              </h2>
            </div>
          </div>

          <p class="text-foreground/85 leading-relaxed mb-6">
            The issues below are workflow problems. Texts, group chats, and
            memory were not designed for this volume of work.
          </p>

          <div class="grid sm:grid-cols-2 gap-4">
            {painPoints.map((item) => {
              const Icon = item.icon;
              return (
                <div class="rounded-xl border border-border bg-background/50 p-5">
                  <div class="flex items-start gap-3">
                    <span
                      class="mt-0.5 shrink-0 text-primary"
                      aria-hidden="true"
                    >
                      <Icon size={20} />
                    </span>
                    <div>
                      <h3 class="font-semibold text-foreground mb-1.5">
                        {item.title}
                      </h3>
                      <p class="text-sm text-muted-foreground leading-relaxed">
                        {item.body}
                      </p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>

          <h3 class="mt-8 mb-3 font-semibold text-foreground">
            Current process and proposed process
          </h3>
          <div class="overflow-x-auto rounded-xl border border-border">
            <table class="w-full text-sm min-w-[640px]">
              <thead class="bg-muted/70">
                <tr>
                  <th class="text-left px-4 py-3 font-semibold text-foreground w-1/2">
                    Today
                  </th>
                  <th class="text-left px-4 py-3 font-semibold text-foreground w-1/2">
                    With the system
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    New text → see it later → ask questions over 40 minutes
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Instant reply → details collected in about a minute → you get
                    a summary
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    Trip details spread across three threads and your memory
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    One record with every detail, searchable in seconds
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    Driver assignments in a group chat
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Separate calendar events, one per driver and rider
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    “Did they pay?” means manual checking
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Pipeline shows confirmed, completed, paid, and unpaid trips in one view
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    Reminder texts typed by hand, when you remember
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Automatic at 24h, 3h, and 30m — with map, driver, and payment
                    link
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-muted-foreground">
                    Referrals go to Facebook Messenger and wait
                  </td>
                  <td class="px-4 py-3 text-foreground">
                    Referrals land on a website that answers questions and
                    captures the trip
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ============================= WHAT YOU GET ============================= -->
        <section
          id="what-you-get"
          class="scroll-mt-28 bg-card rounded-2xl border border-border shadow-sm p-6 sm:p-8 mb-6"
        >
          <div class="flex items-start gap-4 mb-6">
            <div
              class="shrink-0 w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center"
            >
              <Sparkles size={22} />
            </div>
            <div>
              <p
                class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary mb-1"
              >
                System components
              </p>
              <h2 class="text-2xl sm:text-3xl font-bold text-foreground leading-tight">
                What the system includes
              </h2>
